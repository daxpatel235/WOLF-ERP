# Copy to `.env` and set the backend base URL to switch the app from the
# built-in mock data to the real `server/` API. Leave it unset/empty to keep
# the offline mock demo.
#
# IMPORTANT: include the trailing `/api` (the server mounts routes under /api).
#
#   Deployed backend (recommended for a phone / Expo Go):
# EXPO_PUBLIC_API_URL=https://your-wolf-erp-server.onrender.com/api
#
#   Local server on the same Wi-Fi (use your PC's LAN IP, not localhost):
# EXPO_PUBLIC_API_URL=http://172.28.52.160:5000/api
#
#   Android emulator reaching a server on the host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

EXPO_PUBLIC_API_URL=
