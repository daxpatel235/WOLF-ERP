# Wolf ERP — example environment configuration.
# Copy the relevant blocks into server/.env and client/.env.local.

# ── Backend (server/.env) ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/wolf_erp
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# SMTP is optional — if unset, emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Wolf ERP <no-reply@wolferp.in>

# AI features — powered by Google Gemini (FREE tier). If GEMINI_API_KEY is unset,
# the AI endpoints return a friendly 503 and the AI buttons hide themselves.
# Create a key at https://aistudio.google.com/apikey  (no credit card needed).
# Keep the key from Google AI Studio (not a billed Cloud project) to stay free.
GEMINI_API_KEY=
# gemini-2.5-flash supports vision + structured output on the free tier.
# Lighter/higher-quota alternatives: gemini-2.0-flash, gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash
# Model used for document scanning. Defaults to Flash — gemini-2.5-pro is NOT on
# the free tier (its free-tier quota is 0; it needs a billing-enabled project).
# Flash scans clean invoices accurately for free. Set to gemini-2.5-pro only if
# you enable billing and want the extra accuracy on messy/handwritten docs.
GEMINI_SCAN_MODEL=gemini-2.5-flash

# Optional: answer the RAG chat box with Groq instead of Gemini. Groq's free
# tier serves much larger open models (Llama 3.3 70B) with generous limits —
# better chat quality at no cost. Only the chat ANSWER moves to Groq; document
# scanning and embeddings stay on Gemini. Leave GROQ_API_KEY blank to keep chat
# on Gemini. Free key (no card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Level 3 RAG chat (embeddings + vector search) ──
# Embeddings let the chat assistant answer from your own ERP records. Free with
# the same Gemini key. gemini-embedding-001 supports Matryoshka output sizes;
# EMBED_DIM must equal the size we request AND your Atlas index numDimensions.
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Name of the Atlas Search vector index on the `knowledgechunks` collection.
# Only used on a real Atlas cluster; on local/in-memory MongoDB the app falls
# back to in-process cosine similarity automatically (no index needed).
# Setup steps: docs/atlas-vector-search.md
VECTOR_INDEX=knowledge_vector_index

# Chat scope guard + cost controls. Off-topic questions (weather, general
# knowledge, etc.) are refused BEFORE the expensive generation call, saving
# tokens. RAG_MIN_SCORE = min similarity (0-1) to treat a question as on-topic
# (tuned for gemini-embedding-001; lower = more lenient). RAG_RATE_* cap how
# many chat messages one user can send per window.
# RAG_ANCHOR_MIN_SCORE = min similarity to a known capability (see
# server/src/config/chatDomain.js — the editable list of what the assistant can
# answer). Lets well-phrased on-topic questions through even if they don't match
# a specific record. Question-to-capability similarity runs high, so keep > MIN_SCORE.
RAG_MIN_SCORE=0.8
RAG_ANCHOR_MIN_SCORE=0.84
RAG_RATE_MAX=30
RAG_RATE_WINDOW_MS=300000

# Document-scan cap per user: at most SCAN_RATE_MAX uploads per SCAN_RATE_WINDOW_MS.
# Default = 2 scans per 60s (keeps under the Pro model's 5 req/min free-tier limit).
SCAN_RATE_MAX=2
SCAN_RATE_WINDOW_MS=60000

# ── Frontend (client/.env.local) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
