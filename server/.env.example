# Copy this file to ".env" and adjust values.
MONGO_URI=mongodb://127.0.0.1:27017/wolf_erp
PORT=5000
NODE_ENV=development
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15d
CLIENT_URL=http://localhost:3000

# Optional seed admin. Self-registration cannot create admins, so set these to
# get one admin account when seeding. Leave blank to seed no admin.
# (You can also promote an existing user later: npm run make-admin -- you@x.com)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Optional SMTP (blank = emails are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Wolf ERP <no-reply@wolferp.in>

# Dormancy cleanup (free-tier storage guard).
# A weekly external cron hits POST /api/admin/cleanup with this secret in the
# x-cleanup-token header. If nobody has logged in for CLEANUP_INACTIVE_DAYS days,
# every collection except User is wiped (logins are kept forever).
# Leave CLEANUP_TOKEN blank to disable the endpoint entirely.
CLEANUP_TOKEN=change_me_to_a_long_random_string
CLEANUP_INACTIVE_DAYS=30
